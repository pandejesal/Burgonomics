# Agent tooling / runtime state (never commit)
.agents/
.opencode/
.swarm/
.swarm-worktrees/
.firebase/

# Secrets & credentials (never commit)
CLIENT_HANDOVER_AND_KEYS.md
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.key
*.cer
*.mobileprovision
google-services.json
GoogleService-Info.plist
serviceAccountKey.json

# Build / generated artifacts
*.out
*.exe
node_modules/
.vite/

# Large binary media (not needed for source attribution)
ULTRA FINAL MENU PICS/
*.pptx

# Local-only reference archives (docs point at them; too heavy/unrelated for git)
_archive/netlify-legacy/
_archive/screenshots/

# Standalone app repos (own git history)
burgonomics-foundation-core/
burgonomics-partner/
# Agent session traces
scripts/session_*.json
scripts/petpooja-ip-watch.log
scripts/petpooja-sandbox-evidence.json

# Autonomous audit artifacts (local evidence: ledger, bug register, logs, screenshots)
audit-results/

# Nested third-party checkouts (own git history; manifests stay tracked)
rea/
developer-resources/**/repos/

# Release binaries and generated bundles (built locally, not source)
*.apk
*.aab
*.ipa
stages/08_menu/output/**/*.map
stages/08_menu/output/**/*.zip
client-handover/release-builds/*.apk
client-handover/release-builds/*.aab

# Screenshot evidence stays local; the markdown reports cite it
stages/08_menu/output/**/*.png
stages/08_menu/output/**/*.jpg

# Generated browser/preview caches
stages/08_menu/output/**/.vite-cache-*/

# Merge leftovers and editor backups
.merge_file_*
*.bak-*
