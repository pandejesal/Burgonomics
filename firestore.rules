// CANONICAL Firestore rules — deployed by firebase.json at this root.
// burgonomics-partner/firestore.rules and
// burgonomics-foundation-core/firestore.rules are byte-identical MIRRORS for
// the app-local emulators. NEVER edit a mirror: change this file, re-sync
// both mirrors, and re-run the rules suite (core: node scripts/test-rules.mjs).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (RBAC & Identity)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function brandRoles() {
      return ['brand_owner', 'developer'];
    }

    function staffRoles() {
      return ['brand_owner', 'developer', 'support', 'regional_manager', 'branch_owner', 'branch_staff'];
    }

    function hasRole(roles) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && getAdminDoc().data.role in roles) ||
        (request.auth.token != null && (request.auth.token.role in roles))
      );
    }

    // B3-S1 (H-M4/C5): narrowed to BRAND roles only. Previously ANY
    // admins-doc holder (branch_staff/support/regional) passed isAdmin(),
    // leaking cross-branch chats, the payment ledger, and customer profiles.
    // Branch/support access now flows ONLY via isStaff()/ownsBranch() on
    // paths that explicitly grant it — never via isAdmin(). NOTE: a legacy
    // admins doc WITHOUT a role field no longer passes (fail-closed); the
    // claims setter mirrors role into the doc on every assignment.
    function isAdmin() {
      return hasRole(brandRoles());
    }

    // Non-brand operators (support/regional/branch). Usable ONLY where a
    // path explicitly grants operator access (e.g. branch announcements);
    // customer PII and money ledgers stay brand-only via isAdmin().
    function isStaff() {
      return hasRole(staffRoles());
    }

    function isBrandOwner() {
      return isAdmin();
    }

    function isBranchOwner() {
      return hasRole(['branch_owner', 'branch_staff']);
    }

    function ownsBranch(branchId) {
      return isBrandOwner() || (
        isBranchOwner() && (
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && getAdminDoc().data.branchId == branchId) ||
          (request.auth.token != null && branchId in request.auth.token.branchIds)
        )
      );
    }

    // Loop 12: delivery handover needs OTP proof — POST
    // /orders/verifyDeliveryOtp flips to DELIVERED server-side (lockout +
    // timing-safe compare). A direct client status write to DELIVERED on a
    // delivery order bypasses that proof, so staff client updates may never
    // perform it. Takeaway/dine-in complete in person; brand owners keep
    // full access. Missing/non-map status never matches (no block).
    function directDeliveredBypass() {
      return request.resource.data.status is map
        && request.resource.data.status.code == 'DELIVERED'
        && resource.data.orderType == 'delivery';
    }

    // =========================================================================
    // CRM: CUSTOMERS & GLOBAL LOYALTY (Brand-wide)
    // =========================================================================

    match /customers/{customerId} {
      allow read: if isUser(customerId) || isAdmin();
      allow create: if isUser(customerId)
        && (!('loyaltyPoints' in request.resource.data) || request.resource.data.loyaltyPoints == 0);
      allow update: if (isUser(customerId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['loyaltyPoints', 'role', 'isStaff']))
        || isBrandOwner();
      allow delete: if false;

      match /addresses/{addressId} {
        allow read: if isUser(customerId) || isAdmin();
        allow write: if isUser(customerId);
      }
    }

    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId)
        && !request.resource.data.keys().hasAny(['role', 'isStaff', 'isBrandAdmin', 'isSuperAdmin', 'grillCoins', 'loyaltyPoints']);
      allow update: if isBrandOwner() || (
        isUser(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isStaff', 'isBrandAdmin', 'isSuperAdmin', 'grillCoins', 'loyaltyPoints'])
      );
      allow delete: if false;

      match /addresses/{addressId} {
        allow read: if isUser(userId) || isAdmin();
        allow write: if isUser(userId);
      }

      match /notifications/{notifId} {
        allow read: if isUser(userId) || isAdmin();
        allow create: if false; // server-only via Admin SDK (fcm.service.ts)
        // B3-S1 field mask: read-receipts only; server owns body/priority.
        allow update: if isUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt']);
        allow delete: if isUser(userId);
      }

      match /orders/{orderId} {
        allow read: if isUser(userId) || isAdmin();
        allow create: if isUser(userId);
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // SALES: ORDERS (Branch-scoped, customer own-only)
    // =========================================================================

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        ownsBranch(resource.data.branchId)
      );

      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );

      allow update: if isBrandOwner() || (
        isBranchOwner() &&
        ownsBranch(resource.data.branchId) &&
        // Loop 12: delivery handover needs OTP proof — never direct.
        !directDeliveredBypass() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'totals', 'pricingSnapshot', 'pricing', 'customerId', 'userId', 'branchId',
          'paymentStatus', 'payment', 'refundStatus', 'refundId', 'refundAmount', 'routeTransferStatus',
          // Loop 7: delivery-OTP proof fields are server-owned (verifyDeliveryOtp
          // path only) — staff must not clear lockouts/attempts or rewrite the
          // hash to bypass handover proof via direct client update.
          'deliveryOtpHash', 'deliveryOtp', 'deliveryOtpAttempts', 'deliveryOtpLockedUntil'
        ])
      ) || (
        // Customers may cancel their own pre-terminal orders only — canonical
        // cancelled literal-shape plus timestamps, nothing else. Terminal
        // orders are immutable to them. Key set pinned to statusMeta
        // (item86ingSync.ts:199-204): code/label/kind/terminal.
        isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
        !(resource.data.status.terminal == true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt']) &&
        request.resource.data.status.code == 'CANCELLED' &&
        request.resource.data.status.kind == 'cancelled' &&
        request.resource.data.status.terminal == true &&
        request.resource.data.status.keys().hasOnly(['code', 'label', 'kind', 'terminal'])
      );

      allow delete: if false;
    }

    // =========================================================================
    // BRANCHES & PRODUCTS CATALOG
    // =========================================================================

    match /branches/{branchId} {
      allow read: if true;
      allow create: if isBrandOwner();
      allow update: if isBrandOwner() || (
        ownsBranch(branchId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'razorpayAccountId', 'petpooja', 'petpoojaStoreId', 'servicedRadiusKm'
        ])
      );
      allow delete: if isBrandOwner();
    }

    // Canonical menu (both apps read; branch staff 86-ing writes).
    // Staff may only touch availability fields — never prices or identity.
    match /products/{productId} {
      allow read: if true;
      allow create: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(request.resource.data.branchId)
      );
      allow update: if isBrandOwner() || (
        isBranchOwner() &&
        ownsBranch(resource.data.branchId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'price', 'compareAtPrice', 'discountPercentage', 'name', 'description',
          'categoryId', 'categoryName', 'branchId', 'restId', 'petpoojaItemId', 'id'
        ])
      );
      allow delete: if isBrandOwner();
    }

    match /menu_items/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    // Per-branch synced menu (partner app: sync + availability toggles)
    match /menu/{branchId}/categories/{docId} {
      allow read: if true;
      allow create, update: if isBrandOwner() || ownsBranch(branchId);
      allow delete: if isBrandOwner();
    }

    match /menu/{branchId}/items/{itemId} {
      allow read: if true;
      allow create, update: if isBrandOwner() || ownsBranch(branchId);
      allow delete: if isBrandOwner();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /admin_stores/{storeId} {
      allow read: if true;
      allow create: if isBrandOwner() || isBranchOwner();
      allow update: if isBrandOwner() || ownsBranch(storeId);
      allow delete: if isBrandOwner();
    }

    // Petpooja catalog — public read, server-side writes via Admin SDK
    match /petpooja_categories/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_products/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_offers/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_sync_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /petpooja_webhook_logs/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Branch launch announcements (partner useBranches broadcastLaunchAlert addDoc)
    // B3-S1: operator-writable (branch owners broadcast for their outlets),
    // still closed to customers/anonymous. Reads stay public (announcements).
    match /branch_announcements/{docId} {
      allow read: if true;
      allow create: if isStaff();
      allow update, delete: if isStaff();
    }

    // =========================================================================
    // SUPPORT TICKETING (support_tickets & tickets)
    // =========================================================================

    // B3-S1 (H-M17/H13): owner direct UPDATE is blocked — status/priority/
    // assignedTo/resolution are staff-only and the tickets.service.ts
    // transitions own every mutation via Admin SDK. Owner writes flow through
    // POST /tickets/* (functions), never through a client update that could
    // escalate/resolve its own ticket.
    match /support_tickets/{ticketId} {
      allow read: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId)
      ) || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
      );
      // Loop 7: create allowlist — a client must not self-set status/
      // resolution/priority/assignedTo or money-action fields (resolutionAction,
      // refundAmount, refundResult, couponCode, amount) at birth; those are
      // server-owned via POST /tickets/* (functions), never through a client
      // write that could escalate/resolve its own ticket.
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.keys().hasOnly([
          'ticketNumber', 'subject', 'description', 'message', 'title',
          'category', 'type', 'branchId', 'orderId', 'customerId', 'customerName',
          'customerPhone', 'status', 'priority', 'assignedTo', 'targetTier',
          'branchReminderSent', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'open';
      // Loop 7: staff update field mask — direct client writes may advance
      // workflow (status/resolution/assignedTo/timeline) but money-action and
      // identity fields resolve server-side only (POST /tickets/resolve).
      allow update: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolution', 'assignedTo', 'timeline',
          'lastActivityAt', 'updatedAt'
        ])
      );
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow read: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId)
      ) || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
      );
      // Loop 7: same create allowlist + staff update mask as support_tickets
      // (legacy collection, same threat model).
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.keys().hasOnly([
          'ticketNumber', 'subject', 'description', 'message', 'title',
          'category', 'type', 'branchId', 'orderId', 'customerId', 'customerName',
          'customerPhone', 'status', 'priority', 'assignedTo', 'targetTier',
          'branchReminderSent', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'open';
      allow update: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolution', 'assignedTo', 'timeline',
          'lastActivityAt', 'updatedAt'
        ])
      );
      allow delete: if false;
    }

    // =========================================================================
    // PAYMENT AUDIT TRAIL & DEVELOPER ERROR SNAPSHOTS (Append-only / Admin read)
    // =========================================================================

    // Server-only append collections — Admin SDK bypasses rules; block all client direct writes
    match /payment_audits/{auditId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    match /paymentAudits/{auditId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Razorpay webhook unmatched parking (webhookHandler.ts) — server-only
    match /unmatched_payments/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Petpooja 86-ing sync unmatched parking (item86ingSync.ts) — server-only
    match /unmatched_petpooja_orders/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Porter webhook unmatched parking (porter.service.ts) — server-only
    match /unmatched_porter_events/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Route transfer event log (webhookHandler.ts) — server-only
    match /route_transfer_events/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    match /dev_error_snapshots/{snapshotId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Payment ledger — partner admin app reads payments and manages refunds/discrepancies
    match /payments/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false; // server-only via Admin SDK
    }

    match /refunds/{refundId} {
      allow read: if isBrandOwner();
      allow create: if false; // server-only via Admin SDK
      allow update: if false; // server-only via Admin SDK
      allow delete: if false;
    }

    match /payment_discrepancies/{docId} {
      allow read: if isBrandOwner();
      allow create: if false; // server-only via Admin SDK
      allow update: if false; // server-only via Admin SDK
      allow delete: if false;
    }

    // =========================================================================
    // CHATS & DIRECT MESSAGING
    // =========================================================================

    // Chat thread metadata — participants may read/update their own threads
    match /chats/{chatId} {
      allow read: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in resource.data.participantIds
      );
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in resource.data.participantIds
      );
      allow delete: if false;
    }

    // Message reads are participant- or brand-scoped — the old admin-only
    // rule let ANY branch staffer (all admins) read EVERY branch's chats.
    // Writers must stamp participantIds on the parent thread doc.
    function chatParticipantIds(pairId) {
      return get(/databases/$(database)/documents/chats/$(pairId)).data.get('participantIds', []);
    }

    match /chats/{pairId}/messages/{messageId} {
      allow read: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in chatParticipantIds(pairId)
      );
      allow create: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in chatParticipantIds(pairId)
      );
      allow update, delete: if false;
    }

    // =========================================================================
    // ADMINS & APP SETTINGS
    // =========================================================================

    match /admins/{uid} {
      allow read: if isUser(uid) || isBrandOwner();
      allow write: if isBrandOwner();
    }

    // Admin session tracking + session listing.
    // B3-S1 (H-R20): sessions are SERVER-minted only (Admin SDK bypasses
    // rules). Client self-mint let any authenticated user fabricate a staff
    // session doc. Partner adminAuthService's client-side session write must
    // move to a server mint (queued to batch 4Z/5); reads are unaffected.
    match /admins/{uid}/sessions/{sessionId} {
      allow read: if isUser(uid) || isBrandOwner();
      allow create, update, delete: if false;
    }

    // Top-level notifications (partner useNotifications reads/updates own by userId)
    // B3-S1 (batch-1 queued field mask): owner updates are read-receipts
    // ONLY — body/userId/priority rewrites are server-owned via dispatchFCM.
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if false; // server-only (no direct-client writer)
      allow update: if isBrandOwner() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
      );
      allow delete: if isBrandOwner();
    }

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /device_tokens/{token} {
      allow read: if false;
      allow create, update, delete: if false; // server-owned via registerToken (index.ts); kills any-auth overwrite
    }

    // =========================================================================
    // FRANCHISE LEADS & COUPONS (India franchise pipeline + promo validation)
    // =========================================================================

    // B3-S1 (M14): franchise creates bind customerId==uid (no victim-id
    // stamping / spam-as-someone-else); updates keep the bind immutable.
    match /franchise_leads/{leadId} {
      allow read: if isBrandOwner() || isBranchOwner();
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isBrandOwner() || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid
      );
      allow delete: if isBrandOwner();
    }

    // Partner app uses 'franchise_inquiries' (useFranchiseLeads) — mirror franchise_leads
    match /franchise_inquiries/{leadId} {
      allow read: if isBrandOwner() || isBranchOwner();
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isBrandOwner() || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid
      );
      allow delete: if isBrandOwner();
    }

    match /coupons/{couponCode} {
      allow read: if true; // public coupon validation at checkout — unauth guest checkout needs read
      allow write: if isBrandOwner();
    }

    // Admin audit trail — immutable append-only
    match /admin_audit_logs/{logId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false; // server-only via Admin SDK
    }
  }
}
