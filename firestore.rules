// CANONICAL Firestore rules — the ROOT copy deployed to production by the
// root firebase.json (firestore config). The copies in
// burgonomics-foundation-core/firestore.rules (emulator target of the rules
// suite, scripts/test-rules.mjs) and burgonomics-partner/firestore.rules
// (reference mirror only — the partner app has no firebase.json deploy
// target) are byte-identical MIRRORS. NEVER edit a mirror: change this file,
// re-sync both mirrors, and re-run the rules suite (core:
// node scripts/test-rules.mjs).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (RBAC & Identity)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // F06 — staff/operator activation. `users/{uid}.active` is the SINGLE
    // authoritative suspension state (server-owned; no claim mirror).
    //
    // Read budget: one `exists` + one `get` on the same document (rules cache
    // the document, so this is effectively ONE additional document access) on
    // top of the `admins/{uid}` access `hasRole` already performs. Well inside
    // the per-evaluation limit.
    //
    // FAIL CLOSED for privileged callers: a missing profile, or a profile
    // without `active == true`, denies. Customer arms never call this helper,
    // so ordinary customer flows gain no staff-profile prerequisite.
    function staffProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function staffActive() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && staffProfile().get('active', false) == true;
    }

    function brandRoles() {
      return ['brand_owner', 'developer'];
    }

    function staffRoles() {
      return ['brand_owner', 'developer', 'support', 'regional_manager', 'branch_owner', 'branch_staff'];
    }

    function hasRole(roles) {
      return isAuthenticated() && (
        // F06: a role is no longer sufficient — the account must be active.
        // Both branches are gated, so neither a stale token claim nor a
        // registry doc can override a suspension. `staffActive()` is the LAST
        // conjunct in each branch: a caller whose role test already fails
        // performs no extra document read (customers included).
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && getAdminDoc().data.role in roles
          && staffActive()
        ) ||
        (
          request.auth.token != null
          && (request.auth.token.role in roles)
          && staffActive()
        )
      );
    }

    // B3-S1 (H-M4/C5): narrowed to BRAND roles only. Previously ANY
    // admins-doc holder (branch_staff/support/regional) passed isAdmin(),
    // leaking cross-branch chats, the payment ledger, and customer profiles.
    // Branch/support access now flows ONLY via isStaff()/ownsBranch() on
    // paths that explicitly grant it — never via isAdmin(). NOTE: a legacy
    // admins doc WITHOUT a role field no longer passes (fail-closed); the
    // claims setter mirrors role into the doc on every assignment.
    function isAdmin() {
      return hasRole(brandRoles());
    }

    // Non-brand operators (support/regional/branch). Usable ONLY where a
    // path explicitly grants operator access (e.g. branch announcements);
    // customer PII and money ledgers stay brand-only via isAdmin().
    function isStaff() {
      return hasRole(staffRoles());
    }

    function isBrandOwner() {
      return isAdmin();
    }

    function isBranchOwner() {
      return hasRole(['branch_owner', 'branch_staff']);
    }

    function ownsBranch(branchId) {
      return isBrandOwner() || (
        isBranchOwner() && (
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && getAdminDoc().data.branchId == branchId) ||
          (request.auth.token != null && branchId in request.auth.token.branchIds)
        )
      );
    }

    // Loop 12: delivery handover needs OTP proof — POST
    // /orders/verifyDeliveryOtp flips to DELIVERED server-side (lockout +
    // timing-safe compare). A direct client status write to DELIVERED on a
    // delivery order bypasses that proof, so staff client updates may never
    // perform it. Takeaway/dine-in complete in person; brand owners keep
    // full access. Missing/non-map status never matches (no block).
    function directDeliveredBypass() {
      return request.resource.data.status is map
        && request.resource.data.status.code == 'DELIVERED'
        && resource.data.orderType == 'delivery';
    }

    // Orders CREATE (both lanes): ALLOWLIST of exactly the keys the two real
    // creators write. Audited against the CURRENT app sources:
    //   - core ordersService.createOrder (persisted payload): id, shortCode,
    //     status, fulfillment, store, address, deliveryAddress, deliveryQuoteId
    //     (delivery only), items, totals, promo, tipAmount,
    //     loyaltyPointsRedeemed, notes, fulfillmentInstructions, tableNumber,
    //     whatsappOptIn, payment, placedAt, estimatedAt, userId, customerId,
    //     createdAt, updatedAt, branchId, branchCoordinates,
    //     checkoutFingerprint, petpoojaError. (`petpoojaStatus` is DELETED
    //     before the write — server-owned.)
    //   - partner ManualOrderCreateModal / walkInOrder.createOrderDocIfAbsent:
    //     id, customerId, userId, customerName, customerPhone, branchId,
    //     branchName, city, items, subtotal, tax, deliveryFee, total,
    //     orderType, tableNumber, status, paymentMethod, paymentStatus,
    //     specialInstructions, createdAt, updatedAt. (The walk-in no longer
    //     stamps petpoojaSyncStatus — server-owned.)
    // Everything else — forged lease state, planted refund claims, POS sync
    // state or any literal-dotted binding — is refused by construction.
    // CUS-06 regression guard: deliveryQuoteId is REQUIRED here (a delivery
    // create carries it), or every real delivery checkout is denied.
    function orderCreateAllowedKeys() {
      return [
        // Identity + placement (both lanes).
        'id', 'shortCode', 'orderId', 'customerId', 'userId', 'branchId', 'branchName', 'city',
        'branchCoordinates', 'orderType', 'fulfillment', 'tableNumber',
        'customerName', 'customerPhone',
        // Basket and client-authored pricing snapshot (repriced server-side at
        // payment verification; cash-lane totals are a documented residual).
        'items', 'subtotal', 'tax', 'deliveryFee', 'total', 'totals', 'tipAmount',
        'promo', 'loyaltyPointsRedeemed', 'checkoutFingerprint',
        // Delivery context, notes and fulfilment instructions. deliveryQuoteId
        // is the R8 server courier quote a delivery order is created with.
        'store', 'address', 'deliveryAddress', 'deliveryQuoteId', 'notes',
        'specialInstructions', 'fulfillmentInstructions',
        // Workflow meta.
        'status', 'payment', 'paymentMethod', 'paymentStatus', 'whatsappOptIn',
        'placedAt', 'estimatedAt', 'createdAt', 'updatedAt',
        // Best-effort POS push failure surface (display only — POS STATE —
        // petpoojaStatus/AcceptedNoId/SyncStatus/OrderId — stays server-owned).
        'petpoojaError'
      ];
    }

    // Allowlist over the written top-level keys ONLY (plus the nested-map
    // allowlists beneath them). A literal field name containing a dot
    // ("payment.razorpayPaymentId") is a member of no entry here, so planted
    // legacy bindings are refused; nested injections under allowed maps
    // (inside `payment`) are refused by that map's own hasOnly allowlist in
    // orderCreatePaymentClientFieldsOnly().
    function orderCreateKeysAllowlisted() {
      return orderCreateAllowedKeys().hasAll(request.resource.data.keys());
    }

    // Orders CREATE (both lanes): keys a client must never plant at birth.
    // Kept alongside the allowlist above as the readable policy statement of
    // what is server-owned (the allowlist is the enforcing direction).
    function orderCreateForbiddenKeys() {
      return [
        'deliveryOtp', 'deliveryOtpHash', 'deliveryOtpAttempts', 'deliveryOtpLockedUntil',
        'deliveryOtpVersion', 'deliveryOtpConsumedAt',
        'refund', 'refundStatus', 'refundId', 'refundAmount',
        'refundLedger', 'refundedTotalPaise', 'refundOverCapturedPaise', 'refundNeedsReview',
        'refundActiveClaim', 'refundClaimedAt', 'refundClaimedRequestId',
        'refundClaimedPaymentId', 'refundClaimedPaise', 'refundClaimedKey',
        'refundClaimedReason', 'refundKeyedReceipts',
        'pricing', 'pricingSnapshot', 'petpoojaOrderId', 'dispatchStatus',
        'routeTransferStatus', 'routeTransferNeedsManualSettlement',
        'routeTransferRetryCount', 'routeTransferClaimedAt',
        'routeTransferRetryAt', 'routeTransferError', 'routeTransferTerminalRefusal',
        'paymentChannel', 'monthlyFeeHold',
        'petpoojaAcceptedNoId', 'petpoojaAcceptedNoIdAt', 'petpoojaAcceptedNoIdAck',
        'petpoojaAcceptedNoIdSource', 'petpoojaAcceptedUnrecorded', 'petpoojaAcceptedAck',
        'petpoojaStatus', 'petpoojaSyncStatus', 'petpoojaRetryCount',
        'petpoojaNextRetryAtMs',
        'petpoojaPushClaimedAt', 'petpoojaClaimedAt', 'petpoojaAmbiguousProcessing',
        'petpoojaCallbackAck', 'petpoojaCallbackOrderId', 'petpoojaCallbackClientRef',
        'petpoojaKitchenStatus', 'petpoojaWebhookEventId', 'petpoojaWebhookReceivedAtMs',
        'reconciliation', 'deliveryPartner', 'lastPetpoojaError', 'kotSyncFailed',
        'kotPrinted', 'kotPrintedAt', 'kotPushedAt', 'dispatchProvider', 'dispatchOrderId',
        'dispatchClaimedAt', 'dispatchError', 'dispatchAttempts', 'dispatchGeneration',
        'dispatchPendingCorrelation', 'dispatchReleasedBindings', 'dispatchQuote',
        'porterDispatchStatus', 'porterDispatchClaimedAt', 'needsRebook', 'rebookTrigger',
        'borzoOrderId', 'shadowfaxOrderId', 'porterOrderId'
      ];
    }

    // Orders UPDATE: financial, identity, dispatch and OTP-proof fields are
    // server-owned for BOTH brand and branch staff. The previous brand-owner
    // arm was unmasked, and branch staff could plant refundLedger /
    // refundedTotalPaise accounting that a later refund claim trusted.
    function orderServerOwnedKeys() {
      return [
        'totals', 'pricingSnapshot', 'pricing', 'customerId', 'userId', 'branchId',
        // Walk-in retries trust this original server receipt and request binding.
        // No client, including brand/developer, may plant, edit or remove them.
        'walkInRequestHash', 'walkInReceipt',
        'paymentStatus', 'payment', 'refundStatus', 'refundId', 'refundAmount',
        'refundLedger', 'refundedTotalPaise', 'refundOverCapturedPaise', 'refundNeedsReview',
        'refundActiveClaim', 'refundClaimedAt', 'refundClaimedRequestId',
        'refundClaimedPaymentId', 'refundClaimedPaise', 'refundClaimedKey',
        'refundClaimedReason', 'refundKeyedReceipts',
        'routeTransferStatus', 'routeTransferNeedsManualSettlement',
        'routeTransferRetryCount', 'routeTransferClaimedAt',
        'routeTransferRetryAt', 'routeTransferError', 'routeTransferTerminalRefusal',
        'paymentChannel', 'monthlyFeeHold',
        // A2: the cash receipt and its request binding are server-issued proof
        // of a real cash sale; staff must not plant or edit them (they used to
        // be writable, which let a forged receipt impersonate legacy cash).
        'cashReceipt', 'cashRequestHash', 'couponIntentId',
        // Courier COD money and readiness are server-written. Branch staff
        // must not rewrite the cash due or forge a courier-collection flag.
        'cashDuePaise', 'cashOnDelivery',
        'deliveryOtpHash', 'deliveryOtp', 'deliveryOtpAttempts', 'deliveryOtpLockedUntil',
        'deliveryOtpVersion', 'deliveryOtpConsumedAt',
        'petpoojaAcceptedNoId', 'petpoojaAcceptedNoIdAt', 'petpoojaAcceptedNoIdAck',
        'petpoojaAcceptedNoIdSource', 'petpoojaAcceptedUnrecorded', 'petpoojaAcceptedAck',
        'petpoojaStatus', 'petpoojaSyncStatus', 'petpoojaRetryCount',
        'petpoojaNextRetryAtMs',
        'petpoojaPushClaimedAt', 'petpoojaClaimedAt', 'petpoojaAmbiguousProcessing',
        'petpoojaCallbackAck', 'petpoojaCallbackOrderId', 'petpoojaCallbackClientRef',
        'petpoojaKitchenStatus', 'petpoojaWebhookEventId', 'petpoojaWebhookReceivedAtMs',
        'reconciliation', 'deliveryPartner', 'lastPetpoojaError', 'kotSyncFailed',
        'kotPrinted', 'kotPrintedAt', 'kotPushedAt', 'dispatchProvider', 'dispatchOrderId',
        'dispatchClaimedAt', 'dispatchError', 'dispatchAttempts', 'dispatchGeneration',
        'dispatchPendingCorrelation', 'dispatchReleasedBindings', 'dispatchQuote',
        'porterDispatchStatus', 'porterDispatchClaimedAt', 'needsRebook', 'rebookTrigger',
        'borzoOrderId', 'shadowfaxOrderId', 'porterOrderId',
        // Basket identity and fulfillment are immutable after create: flipping
        // orderType would also defeat directDeliveredBypass(), and a
        // staff-editable basket would let the kitchen cook a different order
        // than the one charged.
        'items', 'orderType', 'fulfillment', 'deliveryStatus',
        'refund', 'refunds',
        // Capture-fulfilment recovery state (payments). These decide whether an
        // order may be confirmed, refunded, or escalated to a human, so a
        // branch/brand owner must never be able to forge or wipe them:
        // `captureStall` alone would let a stalled paid order be hidden, and
        // `captureFulfillmentState` drives the recovery scan's lane membership.
        'captureFulfillment', 'captureFulfillmentState', 'captureStall',
        // Legacy money fields. The policy statement above declares financial
        // fields server-owned, but these were absent from the list, so branch
        // staff could rewrite the totals and payment method of an already
        // settled order. They are not the authority for money decisions
        // (pricing.grandTotal and payment.capturedAmountPaise are), but they
        // feed cash reconciliation, POS financials and customer-facing totals.
        'subtotal', 'tax', 'deliveryFee', 'total', 'tipAmount',
        'promo', 'loyaltyPointsRedeemed', 'paymentMethod', 'deliveryQuoteId',
        // M8 r3 — receipt money proof. The customer receipt prints the amount
        // actually moved from these fields; a staff/owner client must never be
        // able to plant or edit them. The literal dotted name is required:
        // diff().affectedKeys() reports leaf paths, so naming only `payment`
        // does NOT cover `payment.capturedAmountPaise` (nested or literal).
        'cashCollectedPaise', 'payment.capturedAmountPaise', 'receiptEvidence',
        // r2 P1: the POS-cancel queue (lease, attempts, outcome and reason) is
        // server-only. A client must not plant a 'cancelled' outcome to silence
        // a live kitchen ticket, nor clear a lease to double-send a cancel.
        'petpoojaCancelStatus', 'petpoojaCancelReason', 'petpoojaCancelReasonClass',
        'petpoojaCancelRequestedBy', 'petpoojaCancelRequestedAtMs', 'petpoojaCancelRequestedAt',
        'petpoojaCancelNextRetryAtMs', 'petpoojaCancelClaimedAt', 'petpoojaCancelAttemptCount',
        'petpoojaCancelCompletedAt', 'petpoojaCancelAckMessage', 'petpoojaCancelPosOrderId',
        'petpoojaCancelSkippedReason', 'lastPetpoojaCancelError', 'kotCancelFailed',
        // The POS binding is the identity the cancel queue fences against.
        'petpoojaOrderId',
      ];
    }

    // M8 r4 — receipt evidence must stay UNCHANGED on client writes. Staff may
    // still edit unrelated order fields (status via the server endpoint, notes,
    // etc.); only the server merge-set that stamps capture/collection may
    // introduce or change these fields. get() resolves dotted paths inside
    // maps, which is exactly the nested payment.capturedAmountPaise shape.
    function orderReceiptEvidenceServerOwned() {
      return request.resource.data.get('receiptEvidence', null) ==
          resource.data.get('receiptEvidence', null) &&
        request.resource.data.get('cashCollectedPaise', null) ==
          resource.data.get('cashCollectedPaise', null) &&
        request.resource.data.get('payment', {}).get('capturedAmountPaise', null) ==
          resource.data.get('payment', {}).get('capturedAmountPaise', null);
    }

    // Nested payment display marker at birth. The customer lane is
    // pending-only: a client cannot mint a paid/completed settlement marker.
    // Walk-in creation is server-only. Absent payment is fine for older clients.
    //
    // ALLOWLIST the map itself, both lanes: `payment.routeTransfer` (the Route
    // receipt) and the capture/refund bookkeeping are server-written after
    // gateway verification. executeRouteSplit's fast path treats ANY stored
    // `payment.routeTransfer` as an already-executed payout and returns
    // "done" without POSTing the transfer (razorpay.service.ts), so a
    // client-planted receipt at order create silently suppresses the branch
    // settlement. Only the display fields the apps write are allowed.
    function orderCreatePaymentClientFieldsOnly() {
      return !('payment' in request.resource.data) || (
        request.resource.data.payment is map &&
        request.resource.data.payment.keys().hasOnly([
          'method', 'label', 'status', 'transactionId', 'paidAt'
        ])
      );
    }
    function orderCreatePaymentPendingOnly() {
      return orderCreatePaymentClientFieldsOnly() && (
        !('payment' in request.resource.data) || (
          request.resource.data.payment is map &&
          (
            !('status' in request.resource.data.payment) ||
            request.resource.data.payment.status in ['pending', 'Pending', 'PENDING', 'CASH_PENDING', 'PAY_AT_STORE']
          )
        )
      );
    }

    // Orders CREATE (both lanes): the canonical initial status meta only.
    // Core ordersService.createOrder writes resolveStatus('PLACED') =
    // {code:'PLACED',label,kind:'upcoming',terminal:false}; partner
    // ManualOrderCreateModal writes toDeliveryStatusMeta('pending') =
    // the same {code:'PLACED',…} shape (utils/orderContract.ts PARTNER_TO_DELIVERY).
    // Planted terminal/in-flight statuses at birth are denied.
    function orderCreateInitialStatus() {
      return request.resource.data.status is map
        && request.resource.data.status.code == 'PLACED'
        && request.resource.data.status.terminal != true
        && request.resource.data.status.keys().hasOnly(['code', 'label', 'kind', 'terminal']);
    }

    // =========================================================================
    // CRM: CUSTOMERS & GLOBAL LOYALTY (Brand-wide)
    // =========================================================================

    match /customers/{customerId} {
      allow read: if isUser(customerId) || isAdmin();
      // Escalation denylist aligned with users/{userId} (below). Grep of
      // both app sources found NO client writer to customers/* (core
      // loyaltyStore.ts:79 only reads; partner useCustomers/useCustomer only
      // read; grill-coin adjustments go through server functions), so
      // blocking claim-like/PII/projection fields at birth breaks no flow —
      // server writes bypass rules via the Admin SDK.
      allow create: if isUser(customerId)
        && !request.resource.data.keys().hasAny([
          'loyaltyPoints', 'grillCoins', 'role', 'isStaff', 'isBrandOwner',
          'isBrandAdmin', 'isSuperAdmin', 'isAdmin', 'isOwner',
          'phone', 'email', 'createdAt'
        ]);
      allow update: if (isUser(customerId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'loyaltyPoints', 'grillCoins', 'role', 'isStaff', 'isBrandOwner',
        'isBrandAdmin', 'isSuperAdmin', 'isAdmin', 'isOwner',
        'phone', 'email', 'createdAt'
      ])) || isBrandOwner();
      allow delete: if false;

      match /addresses/{addressId} {
        allow read: if isUser(customerId) || isAdmin();
        allow write: if isUser(customerId);
      }
    }

    // Lane 07: users/{uid}.fcmTokens is the push fan-out list that
    // fcmClient.ts/dispatch actually reads. It is REMOVAL-ONLY for EVERY
    // client role (owner and brand alike): the only writers allowed to ADD a
    // token are the Admin SDK seams registerToken
    // (core/deviceTokenRegister.ts) and unregisterToken
    // (modules/notifications/unregisterToken.ts), which prove device_tokens
    // ownership and refuse foreign/ownerless bindings. A client-side append
    // would re-create exactly the foreign-token adoption those seams reject
    // (HTTP 409) through the SDK instead, so a client can never introduce a
    // token value that is not already stored on that same doc: the list may
    // only shrink (or repeat stored values within the stored size bound).
    // Legit client write: notificationsService.unlinkUserFromDeviceToken
    // fallback -> fcmTokens: arrayRemove(token) on the caller's OWN doc.
    function fcmTokensRemovalOnly() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fcmTokens'])
        || (
          request.resource.data.get('fcmTokens', []) is list
          && resource.data.get('fcmTokens', []) is list
          && request.resource.data.get('fcmTokens', []).hasOnly(resource.data.get('fcmTokens', []))
          // hasOnly is a subset test that ignores multiplicity, so the explicit
          // size bound is what stops duplicate-inflation of the fan-out list.
          && request.resource.data.get('fcmTokens', []).size() <= resource.data.get('fcmTokens', []).size()
        );
    }

    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId)
        && !request.resource.data.keys().hasAny(['role', 'isStaff', 'isBrandAdmin', 'isSuperAdmin', 'grillCoins', 'loyaltyPoints', 'branchIds', 'cityIds', 'active', 'isDeleted', 'deletedAt'])
        // First token link is server-stamped by POST /notifications/registerToken.
        && !request.resource.data.keys().hasAny(['fcmTokens']);
      // Brand/operator authority is bounded by the SAME fan-out invariant:
      // attaching a token is server-only for every role, so no client path
      // (owner or brand) can re-create a foreign-token binding the
      // registerToken gate refuses. Role/tenant fields stay brand-writable.
      // F06: `active` (and the suspension/deletion markers) are SERVER-OWNED.
      // The previous brand arm admitted ANY non-fcmTokens key, which is how the
      // partner "Suspend" button wrote `active` directly while authorization
      // ignored it. Suspension now only happens through POST /auth/suspendStaff.
      allow update: if (isBrandOwner() && fcmTokensRemovalOnly() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['active', 'suspendedAt', 'suspendedBy', 'isDeleted', 'deletedAt'])) || (
        isUser(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isStaff', 'isBrandAdmin', 'isSuperAdmin', 'grillCoins', 'loyaltyPoints', 'branchIds', 'cityIds', 'active', 'isDeleted', 'deletedAt'])
        && fcmTokensRemovalOnly()
      );
      allow delete: if false;

      match /addresses/{addressId} {
        allow read: if isUser(userId) || isAdmin();
        allow write: if isUser(userId);
      }

      match /notifications/{notifId} {
        allow read: if isUser(userId) || isAdmin();
        allow create: if false; // server-only via Admin SDK (fcm.service.ts)
        // B3-S1 field mask: read-receipts only; server owns body/priority.
        allow update: if isUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt']);
        allow delete: if isUser(userId);
      }

      // Shadow-order subcollection: grep of both app sources + functions/
      // found NO client or function writer/reader of users/{uid}/orders
      // (only users/{uid}/notifications is used client-side). Writes are
      // therefore server-only (Admin SDK bypasses rules); the identity-only
      // create here was an unused privilege.
      match /orders/{orderId} {
        allow read: if isUser(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // =========================================================================
    // SALES: ORDERS (Branch-scoped, customer own-only)
    // =========================================================================

    // Regional scope is derived solely from the authoritative registry, never
    // a stale token or a client-selected outlet. This helper is orders-only.
    // F06: a regional operator is privileged, so the registry row alone is no
    // longer enough — the account must also be active.
    function regionalOrderRead(branchId) {
      let admin = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
      return admin.role == 'regional_manager'
        && admin.branchIds is list
        && admin.branchIds.size() > 0
        && branchId is string && branchId.size() > 0
        && branchId in admin.branchIds
        && staffActive();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        hasRole(['support']) ||
        regionalOrderRead(resource.data.branchId) ||
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        ownsBranch(resource.data.branchId)
      );

      // Loop-hardening: the old identity-only create (`customerId == uid ||
      // userId == uid`) let any authenticated user birth an order with
      // arbitrary totals/paymentStatus/status — or stamp a VICTIM's id in
      // one identity field while owning the other. Two accepted shapes,
      // both verified against the live client payloads:
      //  1) Customer app (core ordersService.createOrder, src/features/
      //     orders/services/ordersService.ts:331-351) stamps BOTH customerId
      //     AND userId to request.auth.uid.
      // Sentinel walk-ins are created only by the server, including when an
      // authenticated UID happens to equal the sentinel.
      allow create: if isAuthenticated() && (
        (
          request.resource.data.customerId != 'cust_walkin' &&
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          orderCreateInitialStatus() &&
          orderCreateKeysAllowlisted() &&
          orderCreatePaymentPendingOnly() &&
          (
            !('paymentStatus' in request.resource.data) ||
            request.resource.data.paymentStatus in ['pending', 'Pending', 'PENDING', 'CASH_PENDING', 'PAY_AT_STORE']
          )
        )
      );

      allow update: if (
        isBrandOwner() &&
        !directDeliveredBypass() &&
        // SEC-04 applies to EVERY client role: status moves only through
        // POST /orders/bumpStatus (scope check + audit record).
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(orderServerOwnedKeys()) &&
        orderReceiptEvidenceServerOwned()
      ) || (
        isBranchOwner() &&
        ownsBranch(resource.data.branchId) &&
        // Loop 12: delivery handover needs OTP proof — never direct.
        !directDeliveredBypass() &&
        // SEC-04: status moves ONLY through POST /orders/bumpStatus (branch
        // scope check + audit record). No partner client writes an order's
        // status directly; letting the rule allow it bypassed that audit.
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(orderServerOwnedKeys()) &&
        orderReceiptEvidenceServerOwned()
      ) || (
        // F24: customers may NOT write order status at all. A direct
        // `{status: CANCELLED}` client write skipped the server-owned
        // cancellation obligations (durable rider-cancel intent + idempotent
        // Grill-Coins restore) that only POST /orders/customerCancel performs.
        // The whatsapp opt-in toggle below is the only customer order write.
        isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsappOptIn', 'updatedAt']) &&
        request.resource.data.whatsappOptIn is bool
      );

      allow delete: if false;
    }

    // =========================================================================
    // BRANCHES & PRODUCTS CATALOG
    // =========================================================================

    // Courier cash readiness is an owner/server decision. A branch may still
    // edit its own cash-on-delivery switch/ceiling, but never courierCod.
    function courierCodSnapshot(data) {
      let cod = data is map ? data.get('cashOnDelivery', null) : null;
      return cod is map ? cod.get('courierCod', null) : null;
    }

    match /branches/{branchId} {
      // Hardened: was `if true`, then `isAuthenticated()`. Grep evidence —
      // the customer app NEVER reads branches/* (its store directory is
      // stores/*, separately public); every branches reader is an
      // authenticated partner hook (useBranches/useTickets/useAnalytics/
      // useBranchMenu). SEC-06: branch docs carry restIDs and
      // razorpayAccountId, so a signed-in CUSTOMER must not read them
      // either — only operator roles (isStaff: brand + support/regional/
      // branch) do.
      allow read: if isStaff();
      allow create: if isBrandOwner();
      allow update: if isBrandOwner() || (
        ownsBranch(branchId) &&
        courierCodSnapshot(request.resource.data) == courierCodSnapshot(resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'razorpayAccountId', 'petpooja', 'petpoojaStoreId', 'servicedRadiusKm',
          // F9: money config is brand-only. A branch may not move its own
          // monthly fee or packaging price.
          'monthlyFee', 'packaging', 'packagingFee', 'royaltyPercentage', 'brandRoyaltyPercent'
        ])
      );
      allow delete: if isBrandOwner();
    }

    // Canonical menu (both apps read; branch staff 86-ing writes).
    // Staff may only touch availability fields — never prices or identity.
    match /products/{productId} {
      allow read: if true;
      // Branch-owner create keeps price/name/description/category fields
      // writable: the partner combo builder legitimately creates products
      // client-side (useBranchMenu.createComboMeal, src/features/menu/
      // hooks/useBranchMenu.ts:259-282 — price/originalPrice/name/
      // description/categoryId/categoryName/branchId/restId are its payload).
      // What a branch operator may NOT plant at birth: margin data
      // (costPrice), discount-manipulation fields (compareAtPrice,
      // discountPercentage), or a fabricated petpoojaItemId — the combo
      // builder itself refuses to fabricate one because a fake id in the
      // shared id space could 86 an unrelated POS item (see its Loop-6
      // comment). Brand-owner creates are unrestricted (catalog imports).
      allow create: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(request.resource.data.branchId) &&
        !request.resource.data.keys().hasAny([
          'costPrice', 'compareAtPrice', 'discountPercentage', 'petpoojaItemId',
          // r3 P2: the outbound stock-push version and lease are server-owned.
          // A client must not fabricate a version to force a stale vendor send,
          // nor plant a claim to block a legitimate toggle.
          'stockVersion', 'stockPushClaim',
          // F9: priced selections and catalog packing data moved into the
          // rules: `customizations` now sets what customers pay, so it gets the
          // same protection as `price`.
          'customizations', 'packingCharge', 'priceAvailable'
        ])
      );
      allow update: if isBrandOwner() || (
        isBranchOwner() &&
        ownsBranch(resource.data.branchId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'price', 'costPrice', 'compareAtPrice', 'discountPercentage', 'name', 'description',
          'categoryId', 'categoryName', 'branchId', 'restId', 'petpoojaItemId', 'id',
          'customizations', 'packingCharge', 'priceAvailable',
          // POS delisting state is decided by the Petpooja sync, never by a
          // client: without these a partner could clear the marker while the
          // SKU is still absent from the POS.
          'delistedFromPos', 'delistedAt',
          // r3 P2: version and lease fence the vendor stock POST and its ACK.
          'stockVersion', 'stockPushClaim'
        ])
      );
      allow delete: if isBrandOwner();
    }

    match /menu_items/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    // Per-branch synced menu (partner app: sync + availability toggles)
    match /menu/{branchId}/categories/{docId} {
      allow read: if true;
      allow create, update: if isBrandOwner() || ownsBranch(branchId);
      allow delete: if isBrandOwner();
    }

    match /menu/{branchId}/items/{itemId} {
      allow read: if true;
      allow create, update: if isBrandOwner() || ownsBranch(branchId);
      allow delete: if isBrandOwner();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    // HOME MERCHANDISING — the customer app queries these anonymously at
    // boot (homeService getHome); without public read the home bundle is
    // always empty. Marketing content only; writes stay brand-owned.
    match /banners/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /combos/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /offers/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /recommendations/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    // Store metadata. Public read is intentional (guest store discovery), which
    // is exactly why client create must not be a scoped privilege: the old
    // `isBranchOwner()` arm let ANY branch operator (including branch_staff)
    // create a doc for ANY store id with an arbitrary shape, and that doc is
    // world-readable. Nothing in the product writes here from a client - the
    // Admin SDK bypasses rules - so create is brand-only and key-masked, and
    // updates stay restricted to the operator's own branch.
    //
    // F17 (audit-remediation-20261117-r1): this collection is the ANONYMOUS
    // DISCOVERY half of an outlet record. It used to hold the kitchen roster
    // (staff names/phones/personal emails), compliance documents, the manager's
    // contacts, Petpooja webhook/sync metadata, queue counters, financial
    // analytics and store settings - all world-readable. Those now live in
    // `admin_stores_private/{storeId}` (brand-only, below). The brand arms
    // therefore require a FULL, shape-validated public document
    // (`hasOnly(public keys)` + per-key type checks + nested map shape), not a
    // changed-key mask: a full replacement is exactly how legacy PII gets
    // REMOVED from an already-public document. The branch arm keeps its narrow
    // metadata allowlist so an outlet operator can still flip its own phone/
    // isActive on an already-clean public document.
    function adminStorePublicKeys() {
      return [
        'title', 'branchId', 'name', 'address', 'city', 'area', 'state',
        'pincode', 'country', 'lat', 'lng', 'latitude', 'longitude', 'phone',
        'imageUrl', 'hours', 'supports', 'pricing', 'isOpen', 'isBusy',
        'isRecentlyOpened', 'isActive', 'status', 'etaMinutes',
        'pickupEtaMinutes', 'minPrepMinutes', 'deliveryFee', 'petpoojaRestId',
        'partnerBranchId', 'deliveryRadiusKm', 'turnOnAt', 'distanceKm',
        'createdAt', 'updatedAt'
      ];
    }

    // "absent OR a string OR an explicit null": `.get(key, null)` keeps an
    // absent key from erroring, and a smuggled map (`name: { staff: [...] }`)
    // still fails the type check.
    function adminStorePublicText(key) {
      return request.resource.data.get(key, null) is string
        || request.resource.data.get(key, null) == null;
    }

    function adminStorePublicNumber(key) {
      return request.resource.data.get(key, null) is number
        || request.resource.data.get(key, null) == null;
    }

    function adminStorePublicBool(key) {
      return request.resource.data.get(key, false) is bool;
    }

    function adminStorePublicHours() {
      return request.resource.data.get('hours', null) == null
        || (request.resource.data.hours is map
            && request.resource.data.hours.keys().hasOnly(['open', 'close'])
            && request.resource.data.hours.get('open', 0) is string
            && request.resource.data.hours.get('close', 0) is string);
    }

    function adminStorePublicSupports() {
      return request.resource.data.get('supports', null) == null
        || (request.resource.data.supports is map
            && request.resource.data.supports.keys().hasOnly([
              'delivery', 'takeaway', 'dineIn'
            ])
            && request.resource.data.supports.get('delivery', 0) is bool
            && request.resource.data.supports.get('takeaway', 0) is bool
            && request.resource.data.supports.get('dineIn', 0) is bool);
    }

    function adminStorePublicPricing() {
      return request.resource.data.get('pricing', null) == null
        || (request.resource.data.pricing is map
            && request.resource.data.pricing.keys().hasOnly([
              'gstRate', 'packingChargePerItem', 'deliveryFeeFlat',
              'freeDeliveryThreshold', 'minOrderAmount'
            ])
            && request.resource.data.pricing.get('gstRate', 0) is number
            && request.resource.data.pricing.get('packingChargePerItem', 0) is number
            && request.resource.data.pricing.get('deliveryFeeFlat', 0) is number
            && request.resource.data.pricing.get('freeDeliveryThreshold', 0) is number
            && request.resource.data.pricing.get('minOrderAmount', 0) is number);
    }

    function adminStorePublicDocShape() {
      return request.resource.data.keys().hasOnly(adminStorePublicKeys())
        && adminStorePublicText('title')
        && adminStorePublicText('branchId')
        && adminStorePublicText('name')
        && adminStorePublicText('address')
        && adminStorePublicText('city')
        && adminStorePublicText('area')
        && adminStorePublicText('state')
        && adminStorePublicText('pincode')
        && adminStorePublicText('country')
        && adminStorePublicText('phone')
        && adminStorePublicText('imageUrl')
        && adminStorePublicText('status')
        && adminStorePublicText('petpoojaRestId')
        && adminStorePublicText('partnerBranchId')
        && adminStorePublicText('turnOnAt')
        && adminStorePublicText('createdAt')
        && adminStorePublicText('updatedAt')
        && adminStorePublicNumber('lat')
        && adminStorePublicNumber('lng')
        && adminStorePublicNumber('latitude')
        && adminStorePublicNumber('longitude')
        && adminStorePublicNumber('etaMinutes')
        && adminStorePublicNumber('pickupEtaMinutes')
        && adminStorePublicNumber('minPrepMinutes')
        && adminStorePublicNumber('deliveryFee')
        && adminStorePublicNumber('deliveryRadiusKm')
        && adminStorePublicNumber('distanceKm')
        && adminStorePublicBool('isOpen')
        && adminStorePublicBool('isBusy')
        && adminStorePublicBool('isRecentlyOpened')
        && adminStorePublicBool('isActive')
        && adminStorePublicHours()
        && adminStorePublicSupports()
        && adminStorePublicPricing();
    }

    // F17 review round 2: the branch arm keeps its EXACT original 8-key mask and
    // ownership check, but the CHANGED values are now typed. Without this,
    // `phone: { staff: [...] }` or `name: { … }` from an outlet operator would
    // still write an anonymous document containing a nested PII map.
    // `updatedAt` accepts a timestamp OR a string so a legacy client write is not
    // broken (the shipped branch callers use `Timestamp.now()`; older importers
    // wrote ISO strings). Missing keys never error, and this does NOT require a
    // legacy document to lose the private fields only a brand cleanup can remove.
    //
    // F17 leak fix: the mask must also be NON-EMPTY. A merge that re-sends an
    // already-stored PRIVATE value (same bytes) produced an empty changed-key
    // set, and `hasOnly([])` is vacuously true - so a no-op merge of a
    // non-public key was admitted. `hasAny(same allowlist)` forces at least one
    // allowed key to actually change; combined with `hasOnly` it can never be
    // satisfiable by a non-public-only diff.
    function adminStoreBranchUpdateShape() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'title', 'name', 'address', 'city', 'area', 'phone', 'isActive', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'name', 'address', 'city', 'area', 'phone', 'isActive', 'updatedAt'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title'])
            || request.resource.data.title is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
            || request.resource.data.name is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['address'])
            || request.resource.data.address is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['city'])
            || request.resource.data.city is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['area'])
            || request.resource.data.area is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
            || request.resource.data.phone is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive'])
            || request.resource.data.isActive is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt is timestamp
            || request.resource.data.updatedAt is string);
    }

    match /admin_stores/{storeId} {
      allow read: if true;
      allow create: if isBrandOwner()
        && adminStorePublicDocShape();
      allow update: if (isBrandOwner()
        && adminStorePublicDocShape()) || (ownsBranch(storeId)
        && adminStoreBranchUpdateShape());
      allow delete: if isBrandOwner();
    }

    // F17: the brand-only half of a store record. Staff/compliance/personal
    // contacts, webhook + queue metadata, financial analytics and settings live
    // here so the anonymous `admin_stores` document can stay discovery-only.
    // Nothing outside the brand roles may read OR write it: guests, customers
    // and branch operators have no product path to this data.
    match /admin_stores_private/{storeId} {
      allow read, write: if isBrandOwner();
    }

    // Petpooja catalog — public read, server-side writes via Admin SDK
    match /petpooja_categories/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_products/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_offers/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_sync_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /petpooja_webhook_logs/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Branch launch announcements (partner useBranches broadcastLaunchAlert
    // addDoc — src/hooks/useBranches.ts:156-186). The companion call posts
    // /notifications/dispatch (partnerFunctionsApi.ts:809), and `upcoming_*`
    // topics are NOT in the server's subscribable allowlist
    // (notifications/topics.ts), so today the fan-out 403s for every role —
    // the doc write is the public-read audit record, and defacement/attribution
    // of that record is the risk this block bounds.
    // Writes are therefore: BRANCH-SCOPED (the doc carries a caller-stamped
    // branchId/targetTopic pair; an operator of branch_02 used to publish,
    // rewrite or delete for branch_01 — or aim targetTopic at another branch's
    // subscribers), TOPIC-BOUND (targetTopic == 'upcoming_' + branchId), and
    // SHAPE-BOUNDED to the exact payload the app sends (title/body caps mirror
    // BroadcastSchema). Global brand/support operators keep their shipped
    // all-branch write; regional_manager was city-clamped upstream, never
    // correct here (UI visibility change is lane 02's call — posted).
    // APPEND-ONLY: no client update/delete path exists in either app (partner
    // only addDoc'ed the record), so the record cannot be rewritten into
    // another branch (or at all) after creation; server moderation goes
    // through the Admin SDK.
    // RESIDUAL (accepted, no reader exists in either app today): branchName/
    // title/body text is caller-chosen, so a global writer could still mislabel
    // the displayed outlet name; binding it would cost one get() per write.
    function branchAnnouncementTopicBound() {
      return request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.targetTopic is string
        && request.resource.data.targetTopic == 'upcoming_' + request.resource.data.branchId;
    }

    function branchAnnouncementShape() {
      return request.resource.data.keys().hasOnly([
          'branchId', 'branchName', 'title', 'body', 'targetTopic', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000;
    }

    function globalAnnouncementWriter() {
      return hasRole(['brand_owner', 'developer', 'support']);
    }

    match /branch_announcements/{docId} {
      allow read: if true;
      allow create: if (globalAnnouncementWriter() || ownsBranch(request.resource.data.branchId))
        && branchAnnouncementTopicBound()
        && branchAnnouncementShape();
      allow update, delete: if false;
    }

    // =========================================================================
    // SUPPORT TICKETING (support_tickets & tickets)
    // =========================================================================

    // B3-S1 (H-M17/H13): owner direct UPDATE is blocked — status/priority/
    // assignedTo/resolution are staff-only and the tickets.service.ts
    // transitions own every mutation via Admin SDK. Owner writes flow through
    // POST /tickets/* (functions), never through a client update that could
    // escalate/resolve its own ticket.
    // Ticket outcomes are server-owned. At root commit 0cca973, the note
    // route writes a string resolution plus terminal status; money actions
    // write a resolution map including couponCode/refundResult/resolvedBy.
    // The server's already-resolved check depends on status, not that map.
    // Both roles and collections share this mask: no field erasure, tenant
    // re-stamping, terminal-status spoofing, or money-map replacement.
    // Once resolved/closed, clients cannot reopen, rewrite resolution, or
    // reassign. Only timeline/updatedAt remain writable for the existing
    // reply fallback. This field mask does NOT enforce append-only history.
    // The allowlist also denies resolutionClaim as defence in depth; a
    // resolution lease is not present in that committed backend revision.
    function ticketWorkflowUpdateOnly() {
      return !request.resource.data.diff(resource.data).removedKeys().hasAny([
          'status', 'resolution', 'assignedTo', 'timeline', 'lastActivityAt', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolution', 'assignedTo', 'timeline', 'lastActivityAt', 'updatedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (request.resource.data.status is string
              && ['open', 'in_progress', 'escalated'].hasAny([request.resource.data.status]))
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['resolution'])
          || (resource.data.get('resolution', '') is string
              && request.resource.data.resolution is string)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedTo'])
          || (request.resource.data.assignedTo is map
              && 'tier' in request.resource.data.assignedTo
              && request.resource.data.assignedTo.keys().hasOnly(['tier'])
              && ['branch', 'brand_support', 'developer_team'].hasAny([request.resource.data.assignedTo.tier]))
        )
        && (
          !(resource.data.get('status', '') == 'resolved'
            || resource.data.get('status', '') == 'closed')
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeline', 'updatedAt'])
        );
    }

    match /support_tickets/{ticketId} {
      allow read: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId)
      ) || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
      );
      // Loop 7: create allowlist — a client must not self-set status/
      // resolution/priority/assignedTo or money-action fields (resolutionAction,
      // refundAmount, refundResult, couponCode, amount) at birth; those are
      // server-owned via POST /tickets/* (functions), never through a client
      // write that could escalate/resolve its own ticket.
      // Hardening: 'priority' and 'assignedTo' removed from the allowlist —
      // grep found NO client create path (partner useTickets.createTicket
      // goes through POST /tickets/create via partnerFunctionsApi; the core
      // app never writes tickets), so the fields are server-stamped only.
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.keys().hasOnly([
          'ticketNumber', 'subject', 'description', 'message', 'title',
          'category', 'type', 'branchId', 'orderId', 'customerId', 'customerName',
          'customerPhone', 'status', 'targetTier',
          'branchReminderSent', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'open';
      // Loop 7: staff update field mask — direct client writes may advance
      // workflow (status/resolution/assignedTo/timeline) but money-action and
      // identity fields resolve server-side only (POST /tickets/resolve).
      // Brand authority now shares the exact same workflow as branch staff —
      // one helper, two arms; only the mask can differ, and it cannot.
      allow update: if (isBrandOwner() && ticketWorkflowUpdateOnly()) || (
        isBranchOwner() && ownsBranch(resource.data.branchId) &&
        ticketWorkflowUpdateOnly()
      );
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow read: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId)
      ) || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
      );
      // Loop 7: same create allowlist + staff update mask as support_tickets
      // (legacy collection, same threat model). 'priority'/'assignedTo' are
      // server-stamped only (POST /tickets/create) — see support_tickets note.
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.keys().hasOnly([
          'ticketNumber', 'subject', 'description', 'message', 'title',
          'category', 'type', 'branchId', 'orderId', 'customerId', 'customerName',
          'customerPhone', 'status', 'targetTier',
          'branchReminderSent', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'open';
      // Same helper, legacy mirror — the masks are mechanically identical.
      allow update: if (isBrandOwner() && ticketWorkflowUpdateOnly()) || (
        isBranchOwner() && ownsBranch(resource.data.branchId) &&
        ticketWorkflowUpdateOnly()
      );
      allow delete: if false;
    }

    // =========================================================================
    // PAYMENT AUDIT TRAIL & DEVELOPER ERROR SNAPSHOTS (Append-only / Admin read)
    // =========================================================================

    // Server-only append collections — Admin SDK bypasses rules; block all client direct writes
    match /payment_audits/{auditId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    match /paymentAudits/{auditId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Razorpay webhook unmatched parking (webhookHandler.ts) — server-only
    match /unmatched_payments/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Petpooja 86-ing sync unmatched parking (item86ingSync.ts) — server-only
    match /unmatched_petpooja_orders/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Porter webhook unmatched parking (porter.service.ts) — server-only
    match /unmatched_porter_events/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Route transfer event log (webhookHandler.ts) — server-only
    match /route_transfer_events/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Refund request identity receipts (razorpay.service.ts autoRefund) —
    // server-only. Denied explicitly rather than left to the default-deny
    // fallback: the document id is a hash of order/payment/request ids and
    // carries money state, so no client lane may read or write it.
    // Allows are additive: review any future overlapping wildcard rules too.
    match /payment_refund_requests/{docId} {
      allow read, write: if false;
    }

    // Dispatch pending-bind correlation tokens (dispatch.router.ts claim tx)
    // — server-only. Keep correlation metadata out of client reads/writes;
    // callbacks must still pass the provider authentication and binding checks.
    match /dispatch_correlation_map/{docId} {
      allow read, write: if false;
    }

    match /dev_error_snapshots/{snapshotId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Payment ledger — partner admin app reads payments and manages refunds/discrepancies
    match /payments/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false; // server-only via Admin SDK
    }

    match /refunds/{refundId} {
      allow read: if isBrandOwner();
      allow create: if false; // server-only via Admin SDK
      allow update: if false; // server-only via Admin SDK
      allow delete: if false;
    }

    match /payment_discrepancies/{docId} {
      allow read: if isBrandOwner();
      allow create: if false; // server-only via Admin SDK
      allow update: if false; // server-only via Admin SDK
      allow delete: if false;
    }

    // =========================================================================
    // CHATS & DIRECT MESSAGING
    // =========================================================================

    // Chat thread metadata — participants may read/update their own threads
    match /chats/{chatId} {
      allow read: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in resource.data.participantIds
      );
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds;
      // Field mask (audit): thread metadata is NOT freely updatable —
      // participantIds/participantNames (membership) and identity fields
      // may not be REWRITTEN by a participant. The only legit client update
      // is the reply metadata written by partner chatService.sendMessage
      // (src/services/chatService.ts:156-160). The ensure-thread merge
      // (chatService.ts:139-154 / useChats.ts:87-96) writes membership fields
      // back with values read from the SAME doc, so they are unchanged and
      // do not appear in diff().affectedKeys(); only an actual membership
      // rewrite trips the mask. getOrCreateBranchChannel's background
      // membership refresh on an EXISTING channel is denied and degrades
      // gracefully (useChats.ts:104-109 catches and warns; the channel
      // still opens).
      allow update: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in resource.data.participantIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageText', 'lastMessageSender', 'lastMessageAt', 'updatedAt'
        ])
      );
      allow delete: if false;
    }

    // Message reads are participant- or brand-scoped — the old admin-only
    // rule let ANY branch staffer (all admins) read EVERY branch's chats.
    // Writers must stamp participantIds on the parent thread doc.
    function chatParticipantIds(pairId) {
      return get(/databases/$(database)/documents/chats/$(pairId)).data.get('participantIds', []);
    }

    // Hardening (audit F3): a participant could forge the message author, so a
    // customer could post as "Burgonomics Support" inside their own thread.
    // The author identity must be the caller: senderId is pinned to the uid,
    // readBy may only contain the caller, and the body is key-masked to the
    // exact shape chatService.sendMessage writes.
    function chatMessageClientKeys() {
      return [
        'chatId', 'senderId', 'senderName', 'senderRole', 'text', 'imageUrl',
        'orderReference', 'ticketReference', 'createdAt', 'readBy'
      ];
    }

    // The claimed role must be one the caller actually holds: their token role,
    // their admin-doc role, or plain 'customer' for a non-staff account.
    // Anything else is an impersonation attempt and is refused.
    // Note: reading a missing map key raises in rules, so the key is tested
    // with `in` before it is read.
    function chatSenderRoleIsOwn() {
      return (
        'role' in request.auth.token
          ? request.resource.data.senderRole == request.auth.token.role
          : (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
              ? (
                'role' in getAdminDoc().data
                  ? request.resource.data.senderRole == getAdminDoc().data.role
                  : false
              )
              : request.resource.data.senderRole == 'customer'
          )
      );
    }

    function chatMessageShapeIsOwn() {
      return request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasOnly(chatMessageClientKeys())
        && chatSenderRoleIsOwn();
    }

    match /chats/{pairId}/messages/{messageId} {
      allow read: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in chatParticipantIds(pairId)
      );
      allow create: if (
        isBrandOwner() && chatMessageShapeIsOwn()
      ) || (
        isAuthenticated() &&
        request.auth.uid in chatParticipantIds(pairId) &&
        chatMessageShapeIsOwn() &&
        request.resource.data.chatId == pairId &&
        request.resource.data.readBy == [request.auth.uid]
      );
      allow update, delete: if false;
    }

    // =========================================================================
    // ADMINS & APP SETTINGS
    // =========================================================================

    match /admins/{uid} {
      allow read: if isUser(uid) || isBrandOwner();
      allow write: if isBrandOwner();
    }

    // Admin session tracking + session listing.
    // B3-S1 (H-R20): sessions are SERVER-minted only (Admin SDK bypasses
    // rules). Client self-mint let any authenticated user fabricate a staff
    // session doc. Partner adminAuthService's client-side session write must
    // move to a server mint (queued to batch 4Z/5); reads are unaffected.
    match /admins/{uid}/sessions/{sessionId} {
      allow read: if isUser(uid) || isBrandOwner();
      allow create, update, delete: if false;
    }

    // Top-level notifications (partner useNotifications reads/updates own by userId)
    // B3-S1 (batch-1 queued field mask): owner updates are read-receipts
    // ONLY — body/userId/priority rewrites are server-owned via dispatchFCM.
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if false; // server-only (no direct-client writer)
      allow update: if isBrandOwner() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
      );
      allow delete: if isBrandOwner();
    }

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /device_tokens/{token} {
      allow read: if false;
      allow create, update, delete: if false; // server-owned via registerToken (index.ts); kills any-auth overwrite
    }

    // =========================================================================
    // NOTIFICATION + DISPATCH SERVER-OWNED PATHS (N09)
    // =========================================================================
    // Backend inventory (source-verified, functions/src):
    //   - modules/notifications/devicePrefs.ts reads/sets
    //     users/{uid}/device_prefs/{installationId} (Admin SDK).
    //   - modules/notifications/sendGate.ts writes notification_quarantine
    //     merge-rows on send-gate violations.
    //   - modules/tickets/supportNotifications.ts writes the attempt ledger
    //     notification_dispatch (Admin SDK).
    //   - dispatch.router.ts / dispatch.webhooks.ts write dispatch_order_map
    //     (pending-bind), dispatch_webhook_events (provider event trail) and
    //     unmatched_dispatch_events (parked, unverified payloads).
    // These paths leak which device belongs to which account (and its
    // category toggles), forensic send state and raw provider receipt lanes:
    // NO client role — brand_owner/developer included — may read or write
    // them. All writes stay Admin SDK (bypasses rules). Overlapping `if false`
    // guards are reviewable tripwires; the real guarantee is the ABSENCE of
    // any overlapping allow statement.
    match /users/{prefOwnerUid}/device_prefs/{installationId} {
      allow read, write: if false;
    }

    match /notification_quarantine/{docId} {
      allow read, write: if false;
    }

    match /notification_dispatch/{docId} {
      allow read, write: if false;
    }

    match /dispatch_order_map/{docId} {
      allow read, write: if false;
    }

    match /dispatch_webhook_events/{docId} {
      allow read, write: if false;
    }

    match /unmatched_dispatch_events/{docId} {
      allow read, write: if false;
    }

    // =========================================================================
    // FRANCHISE LEADS & COUPONS (India franchise pipeline + promo validation)
    // =========================================================================

    // B3-S1 (M14): franchise creates bind customerId==uid (no victim-id
    // stamping / spam-as-someone-else); updates keep the bind immutable.
    // PII-01 (SEC-02): applicant PII (name, phone, email, budget) is
    // brand-level data. `isBranchOwner()` includes branch_staff, so any cashier
    // could read every applicant in the country. Read/update are brand-only;
    // create stays as it was so an applicant can still submit.
    //
    // Hardening (audit F4): create previously had no field allowlist, so an
    // applicant could plant `status: "approved"` / `isApproved: true` at birth
    // and poison the human-reviewed pipeline. `status` stays writable ONLY as
    // the initial `new` value; the brand-side decision is an update, which is
    // brand-only above.
    function franchiseLeadApplicantKeys() {
      return [
        'customerId', 'status', 'name', 'applicantName', 'email', 'phone',
        'city', 'budget', 'investmentBudget', 'commercialSpace', 'spaceAreaSqFt',
        'foodExperienceYears', 'preferredLocation', 'notes', 'message',
        'createdAt', 'updatedAt'
      ];
    }

    match /franchise_leads/{leadId} {
      allow read: if isBrandOwner();
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasOnly(franchiseLeadApplicantKeys())
        && (!('status' in request.resource.data)
          || request.resource.data.status == 'new');
      allow update: if isBrandOwner();
      allow delete: if isBrandOwner();
    }

    // Partner app uses 'franchise_inquiries' (useFranchiseLeads) — mirror franchise_leads
    match /franchise_inquiries/{leadId} {
      allow read: if isBrandOwner();
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasOnly(franchiseLeadApplicantKeys())
        && (!('status' in request.resource.data)
          || request.resource.data.status == 'new');
      allow update: if isBrandOwner();
      allow delete: if isBrandOwner();
    }

    // F4/F9: the monthly-fee ledger. Server-only writes; a brand owner may read
    // any branch's statement, a branch owner only its own. No catch-all exists
    // in this file, so every other identity is denied by default.
    match /branch_monthly_fees/{docId} {
      allow read: if isBrandOwner() || ownsBranch(resource.data.branchId);
      allow write: if false;
    }

    // Franchise settlement (owner decision 2026-11-20): month-end statements.
    // Server-only writes (a regeneration is a NEW docs id, so nothing is ever
    // overwritten); a brand owner reads every branch, a branch owner only its
    // own. Client reads of the statements are optional (the Partner screen goes
    // through the authenticated API), so this stays read-only and denies every
    // other identity by default.
    match /branch_settlements/{docId} {
      allow read: if isBrandOwner() || ownsBranch(resource.data.branchId);
      allow write: if false;
    }

    match /settlement_versions/{docId} {
      allow read: if isBrandOwner();
      allow write: if false;
    }

    // COUPON AUTHORITY (audit 2026-11-20 §1.6). The server is the ONLY writer,
    // and — after this wave — the only READER too: the customer app asks
    // POST /coupons/quote and GET /coupons/available, so no client needs the raw
    // documents. The previous `allow read: if true` let any scraper enumerate
    // every code, discount and cap, which is exactly what
    // references/firebase_security.md claimed had been fixed.
    match /coupons/{couponCode} {
      allow read, write: if false; // server-only (Admin SDK bypasses rules)
    }

    // Redemption ledger. One row per order, written only inside the server's
    // pricing transaction; a customer must never be able to forge or replay one.
    match /coupon_redemptions/{redemptionId} {
      allow read, write: if false;
    }

    // Usage counters that make the cap and the per-customer limit atomic.
    match /coupon_stats/{code} {
      allow read, write: if false;
    }

    match /coupon_customer_usage/{usageId} {
      allow read, write: if false;
    }

    // Staff issue trail ("coupon issued to this customer").
    match /coupon_issues/{issueId} {
      allow read: if isBrandOwner();
      allow write: if false;
    }

    // Admin audit trail — immutable append-only
    match /admin_audit_logs/{logId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false; // server-only via Admin SDK
    }

    // Readiness-8: broadcast history written by POST /notifications/broadcast.
    // Brand-owner read (UI history source); client writes denied — rows are
    // server-measured sends, never client claims.
    match /broadcasts/{broadcastId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false; // server-only via Admin SDK
    }
  }
}
