# Firebase Cloud Functions (asia-south1) — copy to functions/.env and fill in.
# FAIL-CLOSED: every secret below ships EMPTY. An empty env denies webhooks
# (401) and refuses production boot — it never verifies against a mock value.
# Never commit functions/.env. Never invent values here.
FIREBASE_PROJECT_ID=burgonomics-7faa8
FIREBASE_REGION=asia-south1

# Deployment environment — REQUIRED, no default. Boot REFUSES to start when
# this is unset or anything but dev/staging/production (an operator deploying
# without it would otherwise boot half-configured with sleeping guards).
# production = full key + no-mock enforcement; staging = key enforcement only.
BURGONOMICS_ENV=dev

# Razorpay (Production / Sandbox) — from the Razorpay dashboard.
# RAZORPAY_WEBHOOK_SECRET signs inbound payment webhooks; it is NEVER reused
# for OTPs (see OTP_HMAC_SECRET).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Dedicated HMAC secret for delivery OTP hashes. REQUIRED — there is no
# fallback: OTP verification throws until this is set, so rotating
# RAZORPAY_WEBHOOK_SECRET can never invalidate outstanding OTPs.
OTP_HMAC_SECRET=

# Petpooja POS — from the Petpooja panel.
# PETPOOJA_APP_KEY is the SINGLE inbound webhook secret (verifyPetpoojaAuth).
# APP_SECRET / ACCESS_TOKEN are OUR outbound bearers and are never accepted
# inbound — do not paste them into any webhook allowlist.
# PETPOOJA_WEBHOOK_SECRET is the dedicated INBOUND HMAC secret (never sent
# outbound). Starts as a copy of APP_SECRET; set independently to rotate
# inbound trust without touching outbound auth.
PETPOOJA_ENABLED=true
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_WEBHOOK_SECRET=
PETPOOJA_MENU_URL=https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/mapped_restaurant_menus
PETPOOJA_ORDER_URL=https://47pfzh5sf2.execute-api.ap-southeast-1.amazonaws.com/V1/save_order
PETPOOJA_STOCK_URL=https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/update_item_stock
# Where Petpooja POSTs KOT callbacks. Default is derived from FIREBASE_PROJECT_ID;
# set explicitly only for custom domains.
# PETPOOJA_CALLBACK_URL=https://asia-south1-burgonomics-7faa8.cloudfunctions.net/api/petpooja/webhook

# Porter Logistics — from the Porter developer console.
# PORTER_WEBHOOK_SECRET is the single inbound webhook secret (HMAC-SHA256).
PORTER_ENABLED=true
PORTER_API_KEY=
PORTER_CUSTOMER_ID=
PORTER_WEBHOOK_SECRET=
PORTER_BASE_URL=https://api.porter.in

# Multi-provider dispatch (references/delivery_routing.md). OPTIONAL: a provider
# with an empty key is simply excluded from the cheapest-serviceable quote
# fan-out — it is not a failure and never blocks the others.
# BORZO_WEBHOOK_SECRET = Borzo Personal-cabinet Callback Secret Key (inbound
# HMAC-SHA256 in the X-DV-Signature header); SHADOWFAX_WEBHOOK_SECRET = shared
# secret delivered to the Shadowfax team as a custom callback header value
# (x-shadowfax-signature — they have no native HMAC). Empty denies (401).
BORZO_ENABLED=true
BORZO_API_KEY=
BORZO_CUSTOMER_ID=
BORZO_WEBHOOK_SECRET=
# Production Business API 1.8 base; the adapter appends /api/business/1.8.
# Test base: https://robotapitest-in.borzodelivery.com
BORZO_BASE_URL=https://robot-in.borzodelivery.com
SHADOWFAX_ENABLED=true
SHADOWFAX_API_KEY=
# Merchant/client code required by place-order (POST /api/v2/orders/).
SHADOWFAX_CLIENT_CODE=
SHADOWFAX_WEBHOOK_SECRET=
# Hyperlocal Marketplace production base (staging: https://hlbackend.staging.shadowfax.in)
SHADOWFAX_BASE_URL=https://api.shadowfax.in
# Per-provider quote timeout (ms) for the parallel fan-out, and the fare delta
# (₹) that forces a re-confirm when a book-time re-quote drifts (DR7).
DISPATCH_QUOTE_TIMEOUT_MS=6000
DISPATCH_FARE_CONFIRM_DELTA_INR=20
# Opt-in test-window guard (DISPATCH_REQUIRE_LIVE=true only; any other value is
# inert). When on, quote/book refuse to run unless the readiness preflight
# passes: no active dispatch mock, a TEST-mode provider host, and no
# unverified-contract Shadowfax eligible. Dev and production are unaffected.
DISPATCH_REQUIRE_LIVE=false
# Booking-only guard, inert unless DISPATCH_REQUIRE_LIVE=true (exact "true").
# While on, dispatchBook and the direct /porter/book|rebook routes refuse with
# 503 DISPATCH_TEST_BOOKING_BLOCKED until a real rider can be excluded from the
# test window. Quoting is unaffected. Do NOT set this true to "unblock" a test:
# that is the confirmation that a live rider may be dispatched.
DISPATCH_ALLOW_TEST_BOOKING=false

# App Check enforcement (monitor mode by default: invalid tokens logged, never
# rejected — safe while clients enroll. Set true only after web clients ship
# VITE_RECAPTCHA_SITE_KEY and native apps enroll Play Integrity / App Attest).
APP_CHECK_ENFORCEMENT=false

# Developer Alerting Webhooks (leave empty to disable).
SLACK_DEV_WEBHOOK_URL=
DISCORD_DEV_WEBHOOK_URL=

# Sandbox mocks — EXPLICIT OPT-IN ONLY. Each flag engages solely on the exact
# string "true". Missing/empty/any-other-value is LIVE (fail-closed). Never
# enable in production: assertProductionKeys refuses to boot with any mock
# flag on, and with any mock-like secret value.
MOCK_PAYMENT_GATEWAY=false
MOCK_PORTER_DISPATCH=false
MOCK_PETPOOJA_POS=false
MOCK_BORZO_DISPATCH=false
MOCK_SHADOWFAX_DISPATCH=false
