# Firebase Cloud Functions (asia-south1) — copy to functions/.env and fill in.
# FAIL-CLOSED: every secret below ships EMPTY. An empty env denies webhooks
# (401) and refuses production boot — it never verifies against a mock value.
# Never commit functions/.env. Never invent values here.
FIREBASE_PROJECT_ID=burgonomics-7faa8
FIREBASE_REGION=asia-south1

# Razorpay (Production / Sandbox) — from the Razorpay dashboard.
# RAZORPAY_WEBHOOK_SECRET signs inbound payment webhooks; it is NEVER reused
# for OTPs (see OTP_HMAC_SECRET).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Dedicated HMAC secret for delivery OTP hashes. REQUIRED — there is no
# fallback: OTP verification throws until this is set, so rotating
# RAZORPAY_WEBHOOK_SECRET can never invalidate outstanding OTPs.
OTP_HMAC_SECRET=

# Petpooja POS — from the Petpooja panel.
# PETPOOJA_APP_KEY is the SINGLE inbound webhook secret (verifyPetpoojaAuth).
# APP_SECRET / ACCESS_TOKEN are OUR outbound bearers and are never accepted
# inbound — do not paste them into any webhook allowlist.
PETPOOJA_ENABLED=true
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_MENU_URL=https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/mapped_restaurant_menus
PETPOOJA_ORDER_URL=https://47pfzh5sf2.execute-api.ap-southeast-1.amazonaws.com/V1/save_order
PETPOOJA_STOCK_URL=https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/update_item_stock
# Where Petpooja POSTs KOT callbacks. Default is derived from FIREBASE_PROJECT_ID;
# set explicitly only for custom domains.
# PETPOOJA_CALLBACK_URL=https://asia-south1-burgonomics-7faa8.cloudfunctions.net/api/petpooja/webhook

# Porter Logistics — from the Porter developer console.
# PORTER_WEBHOOK_SECRET is the single inbound webhook secret (HMAC-SHA256).
PORTER_ENABLED=true
PORTER_API_KEY=
PORTER_CUSTOMER_ID=
PORTER_WEBHOOK_SECRET=
PORTER_BASE_URL=https://api.porter.in

# App Check enforcement (monitor mode by default: invalid tokens logged, never
# rejected — safe while clients enroll. Set true only after web clients ship
# VITE_RECAPTCHA_SITE_KEY and native apps enroll Play Integrity / App Attest).
APP_CHECK_ENFORCEMENT=false

# Developer Alerting Webhooks (leave empty to disable).
SLACK_DEV_WEBHOOK_URL=
DISCORD_DEV_WEBHOOK_URL=

# Sandbox mocks — EXPLICIT OPT-IN ONLY. Each flag engages solely on the exact
# string "true". Missing/empty/any-other-value is LIVE (fail-closed). Never
# enable in production: assertProductionKeys refuses to boot with any mock
# flag on, and with any mock-like secret value.
MOCK_PAYMENT_GATEWAY=false
MOCK_PORTER_DISPATCH=false
MOCK_PETPOOJA_POS=false
