# Firebase Cloud Functions (asia-south1)
FIREBASE_PROJECT_ID=burgonomics-7faa8
FIREBASE_REGION=asia-south1

# Razorpay (Production / Sandbox)
RAZORPAY_KEY_ID=rzp_test_mockKey123
RAZORPAY_KEY_SECRET=mockSecretKey456
RAZORPAY_WEBHOOK_SECRET=whsec_mockSecret789
# Dedicated HMAC secret for delivery OTP hashes. If unset, the webhook secret
# is reused (warns once) — set this BEFORE rotating RAZORPAY_WEBHOOK_SECRET.
OTP_HMAC_SECRET=""

# Petpooja POS
PETPOOJA_ENABLED=true
PETPOOJA_APP_KEY=mockPetpoojaAppKey
PETPOOJA_APP_SECRET=mockPetpoojaSecret
PETPOOJA_ACCESS_TOKEN=mockPetpoojaToken
PETPOOJA_MENU_URL=https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/mapped_restaurant_menus
PETPOOJA_ORDER_URL=https://47pfzh5sf2.execute-api.ap-southeast-1.amazonaws.com/V1/save_order
PETPOOJA_STOCK_URL=https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/update_item_stock
# Where Petpooja POSTs KOT callbacks. Default is derived from FIREBASE_PROJECT_ID;
# set explicitly only for custom domains.
# PETPOOJA_CALLBACK_URL=https://asia-south1-burgonomics-7faa8.cloudfunctions.net/api/petpooja/webhook

# Porter Logistics
PORTER_ENABLED=true
PORTER_API_KEY=prt_live_mockKey
PORTER_CUSTOMER_ID=cust_mock123
PORTER_WEBHOOK_SECRET=prt_whsec_mockSecret
PORTER_BASE_URL=https://api.porter.in

# Developer Alerting Webhooks
SLACK_DEV_WEBHOOK_URL=https://hooks.slack.com/services/mock/slack/webhook
