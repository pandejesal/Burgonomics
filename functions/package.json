{
  "name": "burgonomics-functions",
  "version": "1.0.0",
  "description": "Burgonomics Firebase Cloud Functions v2 Backend Engine",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backfill:orders": "tsc -p ../scripts/backfill/tsconfig.json && set \"NODE_PATH=node_modules\" && node ../scripts/backfill/dist/backfillOrders.js"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@types/express-rate-limit": "^5.1.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "razorpay": "^2.9.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "typescript": "5.9",
    "vitest": "^5.0.1"
  },
  "private": true
}
